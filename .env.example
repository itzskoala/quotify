# Copy this file to `.env.local` (git-ignored) and fill in your key.
# EXPO_PUBLIC_* vars are inlined into the client bundle at build time, so this
# is fine for a personal build but NOT safe for a public release — move quote
# generation behind a proxy before shipping. See src/lib/anthropic.ts.
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...
